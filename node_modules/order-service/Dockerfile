FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./
COPY apps/order-service/package*.json ./apps/order-service/
COPY apps/order-service/tsconfig.json ./apps/order-service/
COPY apps/order-service/src ./apps/order-service/src

RUN npm install
RUN npm run build -w order-service

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/order-service/package*.json ./apps/order-service/

RUN npm install --omit=dev -w order-service

COPY --from=builder /app/apps/order-service/dist ./apps/order-service/dist

WORKDIR /app/apps/order-service

EXPOSE 3002

CMD ["node", "dist/server.js"]