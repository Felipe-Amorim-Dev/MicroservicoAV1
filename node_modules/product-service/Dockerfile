FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./
COPY apps/products-service/package*.json ./apps/products-service/
COPY apps/products-service/tsconfig.json ./apps/products-service/
COPY apps/products-service/src ./apps/products-service/src

RUN npm install
RUN npm run build -w product-service

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/products-service/package*.json ./apps/products-service/

RUN npm install --omit=dev -w product-service

COPY --from=builder /app/apps/products-service/dist ./apps/products-service/dist

WORKDIR /app/apps/products-service

EXPOSE 3001

CMD ["node", "dist/server.js"]