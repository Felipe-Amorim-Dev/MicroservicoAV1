FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./
COPY apps/gateway-service/package*.json ./apps/gateway-service/
COPY apps/gateway-service/tsconfig.json ./apps/gateway-service/
COPY apps/gateway-service/src ./apps/gateway-service/src

RUN npm install
RUN npm run build -w api-gateway

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/gateway-service/package*.json ./apps/gateway-service/

RUN npm install --omit=dev -w api-gateway

COPY --from=builder /app/apps/gateway-service/dist ./apps/gateway-service/dist

WORKDIR /app/apps/gateway-service

EXPOSE 3000

CMD ["node", "dist/server.js"]